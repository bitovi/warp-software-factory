{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project apps/api/tsconfig.app.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "ts-node --project apps/api/tsconfig.json apps/api/src/main.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --require ts-node/register --test --test-concurrency=1 apps/api/test/*.spec.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --require ts-node/register --test --test-concurrency=1 apps/api/test/*.integration.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project apps/api/tsconfig.json --noEmit"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:generate -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:run -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:revert -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    }
  }
}
