{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build && tsc -p tsconfig.database.json",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      },
      "outputs": ["{workspaceRoot}/dist/apps/api"]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false,
        "inspect": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "typecheck": {
      "command": "tsc -p apps/api/tsconfig.json --noEmit"
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "node --require ts-node/register --require tsconfig-paths/register --test --test-concurrency=1 apps/api/test/*.spec.ts",
          "node --test apps/api/test/api.test.mjs"
        ],
        "parallel": false,
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --require ts-node/register --require tsconfig-paths/register --test --test-concurrency=1 apps/api/test/*.integration.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:generate -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:run -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "typeorm-ts-node-commonjs migration:revert -d apps/api/src/database/data-source.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/api/tsconfig.json"
        }
      }
    }
  },
  "tags": ["scope:api", "type:app"]
}
