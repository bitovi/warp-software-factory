    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@nx/angular": "24.0.5",
    "@nx/devkit": "24.0.5",
    "@nx/eslint": "24.0.5",
    "@nx/eslint-plugin": "24.0.5",
    "@nx/js": "24.0.5",
    "@nx/nest": "24.0.5",
    "@nx/node": "24.0.5",
    "@nx/webpack": "24.0.5",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.0.0",
    "webpack": "5.112.2",
    "webpack-cli": "6.0.1",
    "eslint": "9.39.1",
    "nx": "24.0.5",
    "prettier": "3.6.2",
