  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint && eslint tools/*.mjs eslint.config.mjs",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:boundaries": "node --test tools/module-boundaries.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:boundaries && npm run build"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@spartan-ng/brain": "1.9.0",
    "clsx": "2.1.1",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "21.4.0",
